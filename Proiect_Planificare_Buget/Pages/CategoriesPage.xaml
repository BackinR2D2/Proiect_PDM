<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Proiect_Planificare_Buget.Models"
             xmlns:viewModels="clr-namespace:Proiect_Planificare_Buget.ViewModels"
             x:Class="Proiect_Planificare_Buget.Pages.CategoriesPage"
             x:DataType="viewModels:CategoriesPageViewModel"
             x:Name="CategoriesPageRoot"
             Title="Categorii">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Categorii personalizabile"
                       FontSize="28"
                       FontFamily="OpenSansSemibold" />
                <Label Text="Adauga si organizeaza categorii pentru venituri si cheltuieli."
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <Border Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Adauga sau editeaza categorie"
                           FontFamily="OpenSansSemibold"
                           FontSize="18" />

                    <Entry Placeholder="Nume categorie"
                           Text="{Binding CategoryName}" />

                    <Picker Title="Tip categorie"
                            ItemsSource="{Binding KindOptions}"
                            SelectedItem="{Binding SelectedKind}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Salveaza"
                                Command="{Binding SaveCategoryCommand}" />
                        <Button Grid.Column="1"
                                Text="Goleste formular"
                                Command="{Binding ResetFormCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource Gray500}"
                   FontSize="12" />

            <CollectionView ItemsSource="{Binding Categories}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedCategory}">
                <CollectionView.EmptyView>
                    <Label Text="Nu exista categorii salvate." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryDefinition">
                        <Border Padding="16" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Name}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16" />
                                    <Label Text="{Binding KindLabel}"
                                           TextColor="{Binding AccentColor}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Sterge"
                                        Command="{Binding Source={x:Reference CategoriesPageRoot}, Path=BindingContext.DeleteCategoryCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
