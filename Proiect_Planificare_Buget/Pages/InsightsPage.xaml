<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Proiect_Planificare_Buget.Models"
             xmlns:viewModels="clr-namespace:Proiect_Planificare_Buget.ViewModels"
             x:Class="Proiect_Planificare_Buget.Pages.InsightsPage"
             x:DataType="viewModels:InsightsPageViewModel"
             Title="Insight-uri">

    <RefreshView Command="{Binding RefreshRatesCommand}"
                 IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="18">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Insight-uri si rapoarte"
                           FontSize="28"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Aici combinam datele locale cu acces la retea si exportul XML."
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <Border Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Curs valutar"
                               FontFamily="OpenSansSemibold"
                               FontSize="18" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Picker Grid.Column="0"
                                    Title="Moneda de baza"
                                    ItemsSource="{Binding BaseCurrencyOptions}"
                                    SelectedItem="{Binding SelectedBaseCurrency}" />
                            <Button Grid.Column="1"
                                    Text="Actualizeaza"
                                    Command="{Binding RefreshRatesCommand}" />
                        </Grid>
                        <Label Text="{Binding LastSyncLabel}"
                               TextColor="{StaticResource Gray500}" />

                        <CollectionView ItemsSource="{Binding ExchangeRates}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="Trage in jos sau apasa pe Actualizeaza pentru a incarca ratele." />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ExchangeRateItem">
                                    <Border Padding="14" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Label Text="{Binding CurrencyCode}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Description}"
                                                   TextColor="{StaticResource Gray500}" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding DisplayValue}"
                                                   FontFamily="OpenSansSemibold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Zone cu presiune"
                           FontFamily="OpenSansSemibold"
                           FontSize="18" />
                    <CollectionView ItemsSource="{Binding PressureBudgets}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Nu exista bugete pentru analiza." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BudgetStatusItem">
                                <Border Padding="16" Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding StatusLabel}"
                                                   TextColor="{Binding AccentColor}" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Progress}"
                                                     ProgressColor="{Binding AccentColor}" />
                                        <Label Text="{Binding RemainingLabel}"
                                               TextColor="{Binding AccentColor}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Border Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Export XML"
                               FontFamily="OpenSansSemibold"
                               FontSize="18" />
                        <Label Text="Genereaza un raport XML cu setari, bugete, obiective si tranzactii pentru documentatia proiectului."
                               TextColor="{StaticResource Gray500}" />
                        <Button Text="Genereaza raport XML"
                                Command="{Binding ExportReportCommand}" />
                        <Label Text="{Binding ExportedReportPath}"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}"
                       TextColor="{StaticResource Gray500}"
                       FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
