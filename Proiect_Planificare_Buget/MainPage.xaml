<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Proiect_Planificare_Buget.Models"
             xmlns:viewModels="clr-namespace:Proiect_Planificare_Buget.ViewModels"
             x:Class="Proiect_Planificare_Buget.Pages.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             Title="Overview">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Greeting}"
                       FontSize="28"
                       FontFamily="OpenSansSemibold" />
                <Label Text="{Binding MonthLabel}"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#ECFDF5" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Venituri"
                               TextColor="#047857"
                               FontSize="13" />
                        <Label Text="{Binding IncomeSummary}"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="#065F46" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FEF2F2" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cheltuieli"
                               TextColor="#B91C1C"
                               FontSize="13" />
                        <Label Text="{Binding ExpenseSummary}"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="#991B1B" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#EFF6FF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sold curent"
                               TextColor="#1D4ED8"
                               FontSize="13" />
                        <Label Text="{Binding BalanceSummary}"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="#1E3A8A" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FAF5FF" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Economii"
                               TextColor="#7C3AED"
                               FontSize="13" />
                        <Label Text="{Binding GoalSummary}"
                               FontSize="22"
                               FontFamily="OpenSansSemibold"
                               TextColor="#5B21B6" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Vezi tranzactii"
                        Command="{Binding OpenTransactionsCommand}" />
                <Button Grid.Column="1"
                        Text="Vezi insight-uri"
                        Command="{Binding OpenInsightsCommand}" />
            </Grid>

            <VerticalStackLayout Spacing="12">
                <Label Text="Bugete cu prioritate"
                       FontFamily="OpenSansSemibold"
                       FontSize="18" />
                <CollectionView ItemsSource="{Binding BudgetHighlights}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Nu exista inca bugete configurate." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BudgetStatusItem">
                            <Border Padding="16" Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding AccentColor}"
                                                Padding="8,3"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding StatusLabel}"
                                                   TextColor="White"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold" />
                                        </Border>
                                    </Grid>
                                    <ProgressBar Progress="{Binding Progress}"
                                                 ProgressColor="{Binding AccentColor}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Cheltuit"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}" />
                                            <Label Text="{Binding SpentLabel}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="14" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding RemainingCaption}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Gray500}"
                                                   HorizontalOptions="End" />
                                            <Label Text="{Binding RemainingAmountLabel}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="14"
                                                   TextColor="{Binding AccentColor}"
                                                   HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding LimitLabel}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12">
                <Label Text="Tranzactii recente"
                       FontFamily="OpenSansSemibold"
                       FontSize="18" />
                <CollectionView ItemsSource="{Binding RecentTransactions}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Nu exista tranzactii inregistrate." />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionRecord">
                            <Border Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border BackgroundColor="{Binding BadgeColor}"
                                            StrokeThickness="0"
                                            Padding="8"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding TypeIcon}"
                                               FontFamily="MaterialSymbols"
                                               FontSize="22"
                                               TextColor="{Binding BadgeTextColor}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding Category}"
                                               TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding DateLabel}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding AmountLabel}"
                                           TextColor="{Binding AmountColor}"
                                           FontFamily="OpenSansSemibold"
                                           VerticalOptions="Start" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource Gray500}"
                   FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
